#!/bin/sh
# live-build calls auto/config from the working directory.
set -eu
MIRROR=${COFFEE_MIRROR:-http://deb.debian.org/debian/}
SECURITY_MIRROR=${COFFEE_SECURITY_MIRROR:-http://security.debian.org/debian-security/}

# live-build constructs kernel package names as
# "${LB_LINUX_PACKAGES}-${LB_LINUX_FLAVOURS}" and later finds the boot image
# as "vmlinuz-*${LB_LINUX_FLAVOURS}". A versioned CoffeeKernel package such as
# linux-image-6.12.113-coffee therefore needs package prefix
# "linux-image-6.12.113" with flavour "coffee". Passing the whole
# "6.12.113-coffee" string as the flavour makes live-build look for the
# impossible path vmlinuz-*-6.12.113-coffee.
COFFEE_LINUX_PACKAGES=linux-image
COFFEE_LINUX_FLAVOURS=amd64
set -- config/packages.chroot/linux-image-*-coffee_*.deb
if [ -e "$1" ]; then
  [ "$#" -eq 1 ] || {
    echo "CoffeeOS: expected one staged CoffeeKernel image package, got $#" >&2
    exit 1
  }
  coffee_pkg=$(dpkg-deb -f "$1" Package)
  coffee_kernel=${coffee_pkg#linux-image-}
  case "$coffee_kernel" in
    *-coffee) ;;
    *) echo "CoffeeOS: invalid CoffeeKernel package name: $coffee_pkg" >&2; exit 1 ;;
  esac
  coffee_version=${coffee_kernel%-coffee}
  [ -n "$coffee_version" ] || {
    echo "CoffeeOS: could not derive CoffeeKernel version from: $coffee_pkg" >&2
    exit 1
  }
  COFFEE_LINUX_PACKAGES="linux-image-$coffee_version"
  COFFEE_LINUX_FLAVOURS=coffee
  echo "CoffeeOS: live kernel package prefix: $COFFEE_LINUX_PACKAGES"
  echo "CoffeeOS: live kernel flavours: $COFFEE_LINUX_FLAVOURS"
fi
lb config noauto \
  --mode debian \
  --distribution trixie \
  --architecture amd64 \
  --system live \
  --binary-image iso-hybrid \
  --bootloaders 'syslinux grub-efi' \
  --uefi-secure-boot disable \
  --linux-packages "$COFFEE_LINUX_PACKAGES" \
  --linux-flavours "$COFFEE_LINUX_FLAVOURS" \
  --archive-areas 'main contrib non-free non-free-firmware' \
  --parent-archive-areas 'main contrib non-free non-free-firmware' \
  --security true --updates true \
  --apt-recommends false \
  --apt-options '--yes -o Acquire::Languages=none -o Dpkg::Options::=--force-unsafe-io' \
  --cache true \
  --cache-packages true \
  --cache-indices false \
  --cache-stages bootstrap \
  --chroot-squashfs-compression-type zstd \
  --chroot-squashfs-compression-level 1 \
  --firmware-chroot true \
  --firmware-binary true \
  --backports false \
  --debian-installer none \
  --iso-application 'CoffeeOS Live 0.10.0-dev' \
  --iso-publisher 'CoffeeOS Community (unofficial Debian derivative)' \
  --iso-volume 'COFFEEOS_LIVE' \
  --image-name 'coffeeos' \
  --mirror-bootstrap "$MIRROR" \
  --mirror-chroot "$MIRROR" \
  --mirror-binary "$MIRROR" \
  --mirror-chroot-security "$SECURITY_MIRROR" \
  --mirror-binary-security "$SECURITY_MIRROR" \
  --bootappend-live 'boot=live components username=coffeeos user-fullname='CoffeeOS Live User' hostname=coffeeos console=ttyS0,115200n8 console=tty0' \
  --bootappend-live-failsafe 'boot=live components username=coffeeos user-fullname='CoffeeOS Live User' hostname=coffeeos coffeeos.software-render=1 console=ttyS0,115200n8 console=tty0' \
  "$@"
