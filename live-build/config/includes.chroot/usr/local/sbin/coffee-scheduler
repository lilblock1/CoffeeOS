#!/usr/bin/env python3
"""Safe controller for optional sched_ext schedulers.
CoffeeKernel exposes sched_ext; no experimental scheduler is forced by default.
"""
from pathlib import Path
import argparse, json, os, shutil, signal, subprocess, sys, time
STATE=Path('/run/coffeeos/scx.json')
CANDIDATES=('scx_lavd','scx_bpfland','scx_rusty','scx_flash','scx_simple')

def kernel_state():
    p=Path('/sys/kernel/sched_ext/state')
    return p.read_text().strip() if p.exists() else 'unsupported'
def status():
    d={'kernel_state':kernel_state(),'ops':''}
    p=Path('/sys/kernel/sched_ext/root/ops')
    if p.exists(): d['ops']=p.read_text().strip()
    if STATE.exists():
        try: d['coffeeos']=json.loads(STATE.read_text())
        except ValueError: pass
    d['available']=[x for x in CANDIDATES if shutil.which(x)]
    return d
def stop():
    if STATE.exists():
        try:
            d=json.loads(STATE.read_text()); pid=int(d.get('pid',0))
            if pid>1: os.kill(pid,signal.SIGTERM)
        except (OSError,ValueError): pass
        for _ in range(25):
            if kernel_state()!='enabled': break
            time.sleep(.1)
        STATE.unlink(missing_ok=True)
def start(name):
    if os.geteuid()!=0: raise SystemExit('root required')
    if kernel_state()=='unsupported': raise SystemExit('CoffeeKernel does not expose sched_ext on this boot')
    exe=shutil.which(name)
    if not exe or name not in CANDIDATES: raise SystemExit('scheduler not installed/allowed: '+name)
    stop(); p=subprocess.Popen([exe],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
    STATE.parent.mkdir(parents=True,exist_ok=True); STATE.write_text(json.dumps({'name':name,'pid':p.pid})+'\n')
    time.sleep(.4)
    if p.poll() is not None: STATE.unlink(missing_ok=True); raise SystemExit(f'{name} exited during startup')
def main():
    ap=argparse.ArgumentParser(); sub=ap.add_subparsers(dest='cmd',required=True); sub.add_parser('status'); sub.add_parser('list'); s=sub.add_parser('start'); s.add_argument('name',choices=CANDIDATES); sub.add_parser('stop'); a=ap.parse_args()
    if a.cmd=='status': print(json.dumps(status(),indent=2)); return
    if a.cmd=='list': print('\n'.join(f"{x}\t{'installed' if shutil.which(x) else 'not installed'}" for x in CANDIDATES)); return
    if a.cmd=='start': start(a.name); print(json.dumps(status(),indent=2)); return
    if os.geteuid()!=0: raise SystemExit('root required')
    stop(); print(json.dumps(status(),indent=2))
if __name__=='__main__': main()
