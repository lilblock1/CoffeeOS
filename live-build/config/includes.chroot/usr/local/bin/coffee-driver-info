#!/usr/bin/env python3
import json,shutil,subprocess
def cap(argv,t=10):
    try:
        p=subprocess.run(argv,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=t,check=False);return p.returncode,p.stdout.strip()
    except Exception as exc:return 127,str(exc)
def main():
    _,pci=cap(['lspci','-nnk']);gpus=[];cur=None
    for line in pci.splitlines():
        if any(x in line for x in ('VGA compatible controller','3D controller','Display controller')):cur={'device':line.strip(),'driver':''};gpus.append(cur)
        elif cur and 'Kernel driver in use:' in line:cur['driver']=line.split(':',1)[1].strip()
        elif line and not line[0].isspace():cur=None
    _,gl=cap(['glxinfo','-B']);_,vk=cap(['vulkaninfo','--summary'],15)
    print(json.dumps({'gpus':gpus,'hybrid':len(gpus)>1,'nvidia_tools':shutil.which('nvidia-smi') is not None,'opengl':gl,'vulkan':vk},indent=2))
if __name__=='__main__':main()
