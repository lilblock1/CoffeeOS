#!/usr/bin/env python3
"""CoffeeOS user-level profile preference, intentionally no unsafe sysfs tweaks.

Later versions may connect to a privileged, audited backend. For now this tool
only records a preference and does not claim to alter scheduling or CPU power.
"""
from __future__ import annotations
import argparse
import json
import os
import subprocess
from pathlib import Path

PROFILES = ('lite', 'balanced', 'performance', 'portable')

def config_path():
    return Path(os.environ.get('XDG_CONFIG_HOME') or Path.home()/'.config')/'coffeeos'/'profile.json'

def active():
    try:
        data = json.loads(config_path().read_text())
        value = data.get('profile')
        return value if value in PROFILES else 'balanced'
    except (OSError, ValueError, TypeError):
        return 'balanced'

def recommend():
    try:
        mb = 0
        for line in Path('/proc/meminfo').read_text().splitlines():
            if line.startswith('MemTotal:'):
                mb = int(line.split()[1]) // 1024
                break
        battery = any(Path('/sys/class/power_supply').glob('BAT*'))
        return 'lite' if mb and mb < 4096 else ('portable' if battery else 'balanced')
    except (OSError, ValueError):
        return 'balanced'

def main():
    p=argparse.ArgumentParser(description='CoffeeOS profile preferences and runtime kernel power settings')
    sub=p.add_subparsers(dest='command', required=True)
    sub.add_parser('list'); sub.add_parser('show'); sub.add_parser('recommend')
    sub.add_parser('status'); sub.add_parser('restore')
    for cmd in ('plan', 'apply'):
        sub.add_parser(cmd).add_argument('profile', choices=PROFILES)
    setp=sub.add_parser('set'); setp.add_argument('profile', choices=PROFILES)
    args=p.parse_args()
    if args.command=='list': print('\n'.join(PROFILES))
    elif args.command=='show': print(active())
    elif args.command=='recommend': print(recommend())
    elif args.command in ('status', 'plan', 'apply', 'restore'):
        controller=Path('/usr/local/sbin/coffee-kernel-profile')
        if not controller.exists():
            print('CoffeeKernel runtime controller not installed; use the full CoffeeOS image.', file=__import__('sys').stderr)
            return 1
        return subprocess.run([str(controller), args.command] + ([args.profile] if args.command in ('plan', 'apply') else [])).returncode
    else:
        dst=config_path(); dst.parent.mkdir(parents=True, exist_ok=True)
        os.chmod(dst.parent, 0o700)
        # Atomic replacement to avoid truncation on crash.
        import tempfile
        with tempfile.NamedTemporaryFile('w', dir=dst.parent, delete=False, encoding='utf-8') as fh:
            json.dump({'profile': args.profile},fh,indent=2)
            fh.write('\n'); temporary=Path(fh.name)
        os.chmod(temporary,0o600); temporary.replace(dst)
        print(f"Saved {args.profile} preference (not applied). To switch CPU power settings: sudo coffee-profile apply {args.profile}")

if __name__=='__main__': raise SystemExit(main())
