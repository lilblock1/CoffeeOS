#!/usr/bin/env python3
"""Coffee Control Center — lightweight GTK3 frontend for existing CoffeeOS tools.

Privileged actions are allow-listed and invoked through pkexec as argv arrays;
no user-provided text is evaluated by a shell.
"""
from __future__ import annotations

import argparse
import json
import os
import platform
import shutil
import subprocess
import threading
from pathlib import Path

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gdk, GLib, Gtk

