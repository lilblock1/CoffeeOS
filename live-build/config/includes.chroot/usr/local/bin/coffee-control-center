    def refresh_apps(self):
        rc,raw=capture(['coffee-desktop-settings','defaults'],8)
        try: data=json.loads(raw) if rc==0 else {}
        except ValueError: data={}
        mapping=(('browser',self.default_browser),('text',self.default_text),('image',self.default_image))
        for kind,combo in mapping:
            combo.remove_all()
            for item in data.get('apps',{}).get(kind,[]): combo.append(item['id'],item['name'])
            current=data.get('current',{}).get(kind,'')
            if current: combo.set_active_id(current)
            elif combo.get_model() is not None: combo.set_active(0)
        rc,raw=capture(['coffee-desktop-settings','startup-list'],8)
        try: items=json.loads(raw) if rc==0 else []
        except ValueError: items=[]
        for child in self.startup_list.get_children(): self.startup_list.remove(child)
        for item in items:
            row=Gtk.ListBoxRow(); inner=Gtk.Box(spacing=8); inner.set_border_width(8); row.add(inner); labels=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=2); labels.pack_start(self.label(item.get('name',item.get('id',''))),False,False,0); labels.pack_start(self.label(item.get('id',''),'muted'),False,False,0); inner.pack_start(labels,True,True,0); sw=Gtk.Switch(); sw.set_active(bool(item.get('enabled'))); sw.connect('notify::active',self.startup_toggle,item.get('id','')); inner.pack_end(sw,False,False,0); self.startup_list.add(row)
        self.startup_list.show_all()
    def startup_toggle(self,widget,_param,desktop_id):
        if desktop_id: self.action('Update startup application',['coffee-desktop-settings','startup-toggle',desktop_id,'on' if widget.get_active() else 'off'])
    def apply_defaults(self,*_):
        choices=[('browser',self.default_browser.get_active_id()),('text',self.default_text.get_active_id()),('image',self.default_image.get_active_id())]
        outputs=[]
        for kind,desktop in choices:
            if desktop:
                rc,out=capture(['coffee-desktop-settings','default-set',kind,desktop],5); outputs.append(out or f'{kind}: '+('ok' if rc==0 else 'failed'))
        self.set_status('Default applications updated.'); self.set_log('\n'.join(outputs))
    def install_flatpak(self,*_):
        if self.confirm('Install Flatpak?','Install Flatpak system packages, then enable Flathub for your user?'):
            self.action('Install Flatpak',['pkexec','/usr/local/sbin/coffee-admin-settings','install-feature','flatpak'],self.finish_flatpak_install)
    def finish_flatpak_install(self,rc):
        if rc==0:
            r,o=capture(['coffee-desktop-settings','flatpak-enable-flathub'],30); self.set_log((self.log.get_buffer().get_text(self.log.get_buffer().get_start_iter(),self.log.get_buffer().get_end_iter(),True)+'\n'+o).strip()); self.set_status('Flatpak and Flathub configured.' if r==0 else 'Flatpak installed; Flathub setup failed.')
    def install_printing(self,*_):
        if self.confirm('Install printing support?','This installs CUPS, printer drivers and the graphical printer configuration tool.'):
            self.action('Install printing support',['pkexec','/usr/local/sbin/coffee-admin-settings','install-feature','printing'])

    # Storage, kernel and recovery
    def system_page(self):
        box=self.page_box(); box.pack_start(self.label('System & Recovery','title'),False,False,0)
        self.system_about=self.label(''); box.pack_start(self.system_about,False,False,0)
        self.section(box,'Storage')
        self.storage_status=self.label(''); box.pack_start(self.storage_status,False,False,0)
        self.smart_device=Gtk.Entry(); self.smart_device.set_placeholder_text('/dev/nvme0n1'); self.row(box,'SMART device','Physical SATA/NVMe device to inspect.',self.smart_device)
        sr=Gtk.Box(spacing=8); sr.pack_start(self.button('Refresh Storage',lambda *_:self.refresh_system()),False,False,0); sr.pack_start(self.button('Clean User Cache',self.clean_user),False,False,0); sr.pack_start(self.button('System Cleanup',self.clean_system),False,False,0); sr.pack_start(self.button('SMART Health',self.smart_health),False,False,0); box.pack_start(sr,False,False,0)
        self.section(box,'Kernel & recovery')
        self.recovery_status=self.label(''); box.pack_start(self.recovery_status,False,False,0)
        rr=Gtk.Box(spacing=8); rr.pack_start(self.button('Boot Debian Fallback Next Restart',self.recovery_next,True),False,False,0); rr.pack_start(self.button('Rollback Last CoffeeOS Update',self.rollback_update),False,False,0); box.pack_start(rr,False,False,0)
        box.pack_start(self.label('GRUB stays visible for 5 seconds so the Debian fallback kernel remains manually selectable even if CoffeeKernel has a problem.','muted'),False,False,0)
        self.section(box,'Support')
        br=Gtk.Box(spacing=8); br.pack_start(self.button('Create Support Bundle',self.support_bundle),False,False,0); br.pack_start(self.button('Terminal Hardware Info',lambda *_:self.launch(['foot','-e','coffee-info'])),False,False,0); box.pack_start(br,False,False,0)
        box.pack_start(self.label('Support bundles contain hardware/system diagnostics and warning-level logs, not saved Wi-Fi passwords or your full environment.','muted'),False,False,0)
        return box
    def refresh_system(self):
        self.system_about.set_text(f'{os_name()} · Kernel {platform.release()} · {platform.machine()} · Memory {memory_text()}')
        rc,raw=capture(['coffee-desktop-settings','storage'],8)
        try: data=json.loads(raw) if rc==0 else {}
        except ValueError: data={}
        devices=data.get('lsblk',{}).get('blockdevices',[]) if isinstance(data,dict) else []
        lines=[data.get('root_df','').strip()] if data.get('root_df') else []
        disks=[]
        for item in devices:
            if item.get('type')=='disk':
                name=item.get('name',''); disks.append('/dev/'+name); lines.append(f"/dev/{name}: {item.get('size','?')} · {item.get('model') or 'drive'}")
        lines.append(f"User cache: {int(data.get('user_cache_bytes',0))/1048576:.1f} MiB")
        self.storage_status.set_text('\n'.join(x for x in lines if x))
        if disks and not self.smart_device.get_text(): self.smart_device.set_text(disks[0])
        rc,out=capture(['coffee-admin-settings','recovery-status'],5); self.recovery_status.set_text(out if rc==0 else 'Recovery status unavailable: '+out)
    def clean_user(self,*_): self.action('Clean user caches',['coffee-desktop-settings','clean-user'],lambda _rc:self.refresh_system())
    def clean_system(self,*_):
        if self.confirm('Clean system files?','Remove unused packages, clear the APT cache and trim old journal logs to about 100 MB?'):
            self.action('System cleanup',['pkexec','/usr/local/sbin/coffee-admin-settings','cleanup'],lambda _rc:self.refresh_system())
    def smart_health(self,*_):
        dev=self.smart_device.get_text().strip()
        if dev: self.action('Read SMART health',['pkexec','/usr/local/sbin/coffee-admin-settings','smart',dev])
    def recovery_next(self,*_):
        if self.confirm('Use Debian fallback next boot?','Schedule the next restart to boot the stock Debian kernel. Later boots return to the normal saved GRUB choice.'):
            self.action('Schedule fallback kernel',['pkexec','/usr/local/sbin/coffee-admin-settings','recovery-next'])
    def rollback_update(self,*_):
        if self.confirm('Rollback CoffeeOS packages?','Reinstall the most recent CoffeeOS/CoffeeKernel package snapshot saved immediately before an update.'):
            self.action('Rollback CoffeeOS update',['pkexec','/usr/local/sbin/coffee-update','rollback-latest'],lambda _rc:self.refresh_system())
    def support_bundle(self,*_): self.action('Create support bundle',['coffee-support-bundle'])


    # Performance
    def performance_page(self):
        box = self.page_box(); box.pack_start(self.label('Performance', 'title'), False, False, 0)
        box.pack_start(self.label('CoffeeKernel profiles change supported CPU governor/EPP controls. No overclocking or mitigation disabling.', 'muted'), False, False, 0)
        self.profile_runtime = self.label(''); box.pack_start(self.profile_runtime, False, False, 0)
        self.engine_runtime = self.label(''); box.pack_start(self.engine_runtime, False, False, 0)
        self.profile_radios = {}
        group = None
        for name, detail in PROFILES.items():
            radio = Gtk.RadioButton.new_with_label_from_widget(group, name.capitalize()) if group else Gtk.RadioButton.new_with_label(None, name.capitalize())
            if group is None: group = radio
            self.profile_radios[name] = radio
            self.row(box, name.capitalize(), detail, radio)
        buttons = Gtk.Box(spacing=8)
        buttons.pack_start(self.button('Apply Profile', self.apply_profile, True), False, False, 0)
        buttons.pack_start(self.button('Use Recommended', self.recommend_profile), False, False, 0)
        buttons.pack_start(self.button('Restore Original CPU Settings', self.restore_profile), False, False, 0)
        buttons.pack_start(self.button('Refresh', lambda *_: self.refresh_performance()), False, False, 0)
        box.pack_start(buttons, False, False, 0)
        tools = Gtk.Box(spacing=8)
        tools.pack_start(self.button('Hardware Probe', lambda *_: self.action('Hardware probe',['coffee-hardware-info'])), False, False, 0)
        tools.pack_start(self.button('Quick Benchmark', lambda *_: self.action('Quick benchmark',['coffee-benchmark','--quick'])), False, False, 0)
        tools.pack_start(self.button('Performance Engine Status', lambda *_: self.action('Performance engine status',['coffee-performance-status'])), False, False, 0)
        box.pack_start(tools, False, False, 0)
        return box

    def refresh_performance(self):
        rc, pref = capture(['coffee-profile','show'],3); pref = pref.strip() if rc == 0 else 'balanced'
        if pref in self.profile_radios: self.profile_radios[pref].set_active(True)
        rc, raw = capture(['coffee-profile','status'],5)
        if rc == 0:
            try:
                d=json.loads(raw); selected=d.get('selected') or 'none'; state=d.get('state','unknown'); policies=d.get('policies',{})
                self.profile_runtime.set_text(f'Runtime profile: {selected} ({state})  ·  CPU policies detected: {len(policies)}')
            except ValueError:
                self.profile_runtime.set_text('Runtime profile status unavailable.')
        else: self.profile_runtime.set_text('Runtime profile status unavailable: ' + (raw or 'unknown error'))
        rc, raw = capture(['/usr/local/sbin/coffee-performance-daemon','status'],3)
        try:
            d=json.loads(raw) if rc==0 else {}
            self.engine_runtime.set_text('Adaptive engine: ' + ('gaming active' if d.get('active') else 'idle') + ' · ' + d.get('reason','unknown'))
        except ValueError:
            self.engine_runtime.set_text('Adaptive engine status unavailable.')

    def selected_profile(self):
        return next((n for n,r in self.profile_radios.items() if r.get_active()), 'balanced')

    def apply_profile(self, *_):
        profile=self.selected_profile()
        if not self.confirm('Apply performance profile?', f'Apply the {profile} CoffeeKernel profile to supported CPU controls?'):
            return
        def done(rc):
            if rc == 0: capture(['coffee-profile','set',profile],3)
            self.refresh_performance()
        self.action('Apply performance profile', ['pkexec','/usr/local/sbin/coffee-kernel-profile','apply',profile], done)

    def restore_profile(self, *_):
        if self.confirm('Restore original CPU settings?', 'Restore the governor/EPP values saved before CoffeeOS applied a profile?'):
            self.action('Restore CPU settings', ['pkexec','/usr/local/sbin/coffee-kernel-profile','restore'], lambda _rc:self.refresh_performance())

    def recommend_profile(self, *_):
        rc, raw=capture(['coffee-autotune','--json'],5)
        try: value=json.loads(raw).get('profile','balanced') if rc==0 else 'balanced'
        except ValueError: value='balanced'
        if value in self.profile_radios: self.profile_radios[value].set_active(True)
        self.set_status('Hardware-aware recommendation selected: ' + value + '. Click Apply Profile to activate it.')

    # Gaming
    def gaming_page(self):
        box=self.page_box(); box.pack_start(self.label('Gaming', 'title'), False, False, 0)
        box.pack_start(self.label('Defaults below affect coffee-gaming-mode only. GameMode remains reversible and no overclocking is enabled.', 'muted'), False, False, 0)
        rc, raw=capture(['coffee-gaming-preferences','show'],3)
        try: prefs=json.loads(raw) if rc==0 else {}
        except ValueError: prefs={}
        hud=Gtk.Switch(); hud.set_active(bool(prefs.get('hud',False))); hud.connect('notify::active', self.gaming_pref, 'hud')
        gamescope=Gtk.Switch(); gamescope.set_active(bool(prefs.get('gamescope',False))); gamescope.connect('notify::active', self.gaming_pref, 'gamescope')
        self.row(box,'MangoHud by default','Show MangoHud when launching through Coffee Gaming Mode.',hud)
        self.row(box,'Gamescope by default','Wrap games in fullscreen Gamescope when it is installed.',gamescope)
        actions=Gtk.Box(spacing=8)
        actions.pack_start(self.button('Gaming Diagnostics', lambda *_: self.launch(['foot','-e','coffee-gaming-info'])), False, False, 0)
        actions.pack_start(self.button('Reset Gaming Defaults', self.reset_gaming), False, False, 0)
        box.pack_start(actions, False, False, 0)
        self.section(box,'Steam launch option')
        entry=Gtk.Entry(); entry.set_text('coffee-gaming-mode -- %command%'); entry.set_editable(False); box.pack_start(entry,False,False,0)
        box.pack_start(self.label('SteamAppId is detected automatically, so per-game overrides can be stored without editing launch commands. Gaming Mode also places the game in a high-weight user cgroup when systemd supports it.', 'muted'),False,False,0)
        self.section(box,'MangoHud preset')
        self.mangohud_preset=Gtk.ComboBoxText()
        for value,label in (('off','Off'),('fps','FPS only'),('compact','Compact performance'),('full','Full diagnostics')): self.mangohud_preset.append(value,label)
        self.mangohud_preset.set_active_id('compact'); self.row(box,'Overlay preset','Writes a safe MangoHud configuration preset.',self.mangohud_preset)
        box.pack_start(self.button('Apply MangoHud Preset',self.apply_mangohud_preset),False,False,0)
        self.section(box,'Per-game overrides')
        self.game_id=Gtk.Entry(); self.game_id.set_placeholder_text('Steam App ID'); self.row(box,'Game ID','SteamAppId / SteamGameId.',self.game_id)
        self.game_hud=Gtk.Switch(); self.row(box,'MangoHud for this game','Overrides the global default.',self.game_hud)
        self.game_gamescope=Gtk.Switch(); self.row(box,'Gamescope for this game','Overrides the global default.',self.game_gamescope)
        gr=Gtk.Box(spacing=8); gr.pack_start(self.button('Load Game Settings',self.load_game_settings),False,False,0); gr.pack_start(self.button('Save Game Settings',self.save_game_settings,True),False,False,0); gr.pack_start(self.button('Reset Game Override',self.reset_game_settings),False,False,0); box.pack_start(gr,False,False,0)
        self.section(box,'Controllers')
        self.controller_status=self.label(''); box.pack_start(self.controller_status,False,False,0); box.pack_start(self.button('Refresh Controllers',lambda *_:self.refresh_gaming_devices()),False,False,0)
        return box

    def gaming_pref(self, widget, _param, key):
        value='on' if widget.get_active() else 'off'
        rc,out=capture(['coffee-gaming-preferences','set',key,value],3)
        self.set_status(out if rc==0 else 'Could not save gaming preference: '+out)

    def reset_gaming(self, *_):
        rc,out=capture(['coffee-gaming-preferences','reset'],3); self.set_status(out if rc==0 else out)
    def apply_mangohud_preset(self,*_):
        preset=self.mangohud_preset.get_active_id() or 'compact'; rc,out=capture(['coffee-desktop-settings','mangohud',preset],4); self.set_status('MangoHud preset: '+preset if rc==0 else out)
    def load_game_settings(self,*_):
        gid=self.game_id.get_text().strip()
        if not gid: self.set_status('Enter a Steam App ID first.'); return
        rc,raw=capture(['coffee-gaming-preferences','game-show',gid],4)
        try: data=json.loads(raw) if rc==0 else {}
        except ValueError: data={}
        self.game_hud.set_active(bool(data.get('hud',False))); self.game_gamescope.set_active(bool(data.get('gamescope',False))); self.set_status('Loaded settings for '+gid+'.')
    def save_game_settings(self,*_):
        gid=self.game_id.get_text().strip()
        if not gid: self.set_status('Enter a Steam App ID first.'); return
        for key,value in (('hud',self.game_hud.get_active()),('gamescope',self.game_gamescope.get_active())): capture(['coffee-gaming-preferences','game-set',gid,key,'on' if value else 'off'],4)
        self.set_status('Saved per-game settings for '+gid+'.')
    def reset_game_settings(self,*_):
        gid=self.game_id.get_text().strip()
        if gid: capture(['coffee-gaming-preferences','game-reset',gid],4); self.set_status('Reset per-game settings for '+gid+'.')
    def refresh_gaming_devices(self):
        rc,raw=capture(['coffee-desktop-settings','controllers'],4)
        try: items=json.loads(raw) if rc==0 else []
        except ValueError: items=[]
        self.controller_status.set_text('\n'.join(f"• {x.get('name','Controller')} ({', '.join(x.get('handlers',[]))})" for x in items) if items else 'No game controllers detected.')

    # Appearance
    def appearance_page(self):
        box=self.page_box(); box.pack_start(self.label('Appearance', 'title'), False, False, 0)
        rc,raw=capture(['coffee-appearance','show'],3)
        try: state=json.loads(raw) if rc==0 else {}
        except ValueError: state={}
        combo=Gtk.ComboBoxText()
        for theme_id, label in THEME_CHOICES: combo.append(theme_id,label)
        current=state.get('theme','espresso-noir')
        if current == 'espresso': current='espresso-noir'
        if current == 'latte': current='latte-cream'
        combo.set_active_id(current); combo.connect('changed',self.change_theme)
        self.row(box,'Coffee theme','A complete CoffeeOS preset: windows, GTK apps, panel, launcher, notifications, terminal colors and its matching wallpaper.',combo)
        effects=Gtk.Switch(); effects.set_active(state.get('effects',True)); effects.connect('notify::active',self.change_effects)
        self.row(box,'Desktop effects','Subtle shadows and animations. Gaming Mode temporarily disables these.',effects)
        wp=Gtk.Box(spacing=8); wp.pack_start(self.button('Choose Custom Wallpaper',self.choose_wallpaper),False,False,0); wp.pack_start(self.button('Use Theme Wallpaper',self.reset_wallpaper),False,False,0)
        box.pack_start(wp,False,False,0)
        box.pack_start(self.label('Wallpaper changes restart only swaybg; they do not restart your compositor.', 'muted'),False,False,0)
        self.section(box,'Night Light')
        rc,raw=capture(['coffee-night-light','show'],3)
        try: night=json.loads(raw) if rc==0 else {}
        except ValueError: night={}
        self.night_enabled=Gtk.Switch(); self.night_enabled.set_active(bool(night.get('enabled',False))); self.row(box,'Night Light','Warm the screen to reduce blue light.',self.night_enabled)
        self.night_temp=Gtk.SpinButton.new_with_range(2500,6500,100); self.night_temp.set_value(int(night.get('temperature',4200))); self.row(box,'Color temperature','Lower values are warmer.',self.night_temp)
        self.night_schedule=Gtk.Switch(); self.night_schedule.set_active(bool(night.get('schedule',False))); self.row(box,'Schedule','Automatically apply Night Light during the configured evening window.',self.night_schedule)
        self.night_start=Gtk.Entry(); self.night_start.set_text(night.get('start','19:00')); self.row(box,'Start time','24-hour HH:MM.',self.night_start)
        self.night_end=Gtk.Entry(); self.night_end.set_text(night.get('end','07:00')); self.row(box,'End time','24-hour HH:MM.',self.night_end)
        box.pack_start(self.button('Apply Night Light',self.apply_night_light),False,False,0)
        return box

    def change_theme(self, widget):
        value=widget.get_active_id()
        if value:
            rc,out=capture(['coffee-appearance','theme',value],5)
            if rc==0: apply_theme_style()
            self.set_status(out if rc==0 else 'Theme change failed: '+out)

    def change_effects(self, widget, _param):
        rc,out=capture(['coffee-appearance','effects','on' if widget.get_active() else 'off'],5); self.set_status(out if rc==0 else 'Effect change failed: '+out)

    def choose_wallpaper(self, *_):
        d=Gtk.FileChooserDialog(title='Choose CoffeeOS wallpaper',parent=self,action=Gtk.FileChooserAction.OPEN)
        d.add_buttons(Gtk.STOCK_CANCEL,Gtk.ResponseType.CANCEL,Gtk.STOCK_OPEN,Gtk.ResponseType.OK)
        f=Gtk.FileFilter(); f.set_name('Images'); f.add_pixbuf_formats(); d.add_filter(f)
        if d.run()==Gtk.ResponseType.OK:
            chosen=d.get_filename(); cfg=Path.home()/'.config/coffeeos/wallpaper'; cfg.parent.mkdir(parents=True,exist_ok=True); cfg.write_text(str(Path(chosen).resolve())+'\n')
            self.restart_wallpaper(); self.set_status('Wallpaper changed.')
        d.destroy()

    def apply_night_light(self,*_):
        self.action('Apply Night Light',['coffee-night-light','set','--enabled','on' if self.night_enabled.get_active() else 'off','--temperature',str(self.night_temp.get_value_as_int()),'--schedule','on' if self.night_schedule.get_active() else 'off','--start',self.night_start.get_text().strip(),'--end',self.night_end.get_text().strip()])

    def reset_wallpaper(self, *_):
        (Path.home()/'.config/coffeeos/wallpaper').unlink(missing_ok=True); self.restart_wallpaper(); self.set_status('Theme wallpaper restored.')

    def restart_wallpaper(self):
        capture(['pkill','-x','swaybg'],2)
        try: subprocess.Popen(['coffee-wallpaper'],start_new_session=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        except OSError: pass

    # Software / drivers
    def software_page(self):
        box=self.page_box(); box.pack_start(self.label('Software & Drivers', 'title'),False,False,0)
        box.pack_start(self.label('These are optional on the same CoffeeOS ISO. During installation they are checkboxes in Calamares; after installation you can add them here.', 'muted'),False,False,0)
        self.software_box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=10); box.pack_start(self.software_box,False,False,0)
        for key,(name,_pkg,detail) in OPTIONAL_APPS.items():
            b=self.button('Install',lambda _b,k=key:self.install_optional(k)); self.software_buttons[key]=b
            self.row(self.software_box,name,detail,b)
        self.section(box,'Graphics driver')
        self.driver_status=self.label(''); box.pack_start(self.driver_status,False,False,0)
        driver_buttons=Gtk.Box(spacing=8)
        self.nvidia_button=self.button('Install Debian NVIDIA Driver',self.install_nvidia)
        driver_buttons.pack_start(self.nvidia_button,False,False,0)
        driver_buttons.pack_start(self.button('Refresh',lambda *_:self.refresh_software()),False,False,0)
        box.pack_start(driver_buttons,False,False,0)
        box.pack_start(self.label('NVIDIA installation is explicit and is blocked in the disposable live session. AMD/Intel use Debian Mesa and firmware from the base system.', 'muted'),False,False,0)
        return box

    def refresh_software(self):
        live=is_live()
        for key,(_name,pkg,_detail) in OPTIONAL_APPS.items():
            installed=heroic_installed() if key=='heroic' else package_installed(pkg)
            b=self.software_buttons[key]; b.set_label('Installed' if installed else ('Install after CoffeeOS setup' if live else 'Install'))
            b.set_sensitive(not installed and not live)
        gpu=gpu_text(); nvidia='NVIDIA' in gpu.upper()
        driver_installed=shutil.which('nvidia-smi') is not None
        self.driver_status.set_text(('NVIDIA proprietary driver installed.' if driver_installed else 'Graphics hardware:\n'+gpu))
        self.nvidia_button.set_sensitive(nvidia and not driver_installed and not live)

    def install_optional(self, key):
        name=OPTIONAL_APPS[key][0]
        extra=' This adds the third-party Flathub repository.' if key=='heroic' else ''
        if not self.confirm('Install '+name+'?', 'Packages will be installed using CoffeeOS\'s allow-listed package setup.'+extra): return
        argv=['pkexec','/usr/local/sbin/coffee-gaming-setup']
        if key=='heroic': argv.append('--yes')
        argv.append(key)
        self.action('Install '+name,argv,lambda _rc:self.refresh_software())

    def install_nvidia(self,*_):
        if self.confirm('Install NVIDIA proprietary driver?', 'CoffeeOS will install Debian Stable nvidia-driver packages and matching kernel headers. A reboot will be required.'):
            self.action('Install NVIDIA driver',['pkexec','/usr/local/sbin/coffee-gaming-setup','nvidia'],lambda _rc:self.refresh_software())

    # Updates
    def updates_page(self):
        box=self.page_box(); box.pack_start(self.label('Updates', 'title'),False,False,0)
        box.pack_start(self.label('Update the installed system in place. Debian security/base packages use Debian Stable; CoffeeOS releases can come from a signed CoffeeOS APT feed.', 'muted'),False,False,0)
        self.update_status=self.label(''); box.pack_start(self.update_status,False,False,0)
        self.update_feed=self.label(''); box.pack_start(self.update_feed,False,False,0)
        buttons=Gtk.Box(spacing=8)
        self.update_check=self.button('Check Now',self.check_updates)
        self.update_install=self.button('Install Updates',self.install_updates,True)
        self.update_source=self.button('Update Source',self.configure_update_feed)
        self.update_cleanup=self.button('Clean Old Packages',self.cleanup_updates)
        self.update_rollback=self.button('Rollback Last Update',self.rollback_update)
        for b in (self.update_check,self.update_install,self.update_source,self.update_cleanup,self.update_rollback): buttons.pack_start(b,False,False,0)
        self.update_channel=Gtk.ComboBoxText()
        for value,label in (('stable','Stable'),('beta','Beta'),('dev','Dev')): self.update_channel.append(value,label)
        channel_row=Gtk.Box(spacing=8); channel_row.pack_start(self.update_channel,False,False,0); channel_row.pack_start(self.button('Set Update Channel',self.set_update_channel),False,False,0); box.pack_start(channel_row,False,False,0)
        box.pack_start(buttons,False,False,0)
        box.pack_start(self.label('Stable is recommended for normal use. Beta and Dev receive newer CoffeeOS packages when those suites exist on your signed update feed.','muted'),False,False,0)
        self.update_list=Gtk.TextView(editable=False,cursor_visible=False,monospace=True); self.update_list.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        scroll=Gtk.ScrolledWindow(); scroll.set_min_content_height(240); scroll.add(self.update_list); box.pack_start(scroll,True,True,0)
        return box

    def refresh_updates(self):
        live=is_live()
        self.update_install.set_sensitive(not live); self.update_cleanup.set_sensitive(not live); self.update_source.set_sensitive(not live)
        rc,raw=capture(['/usr/local/sbin/coffee-update','status','--json'],5)
        try: info=json.loads(raw) if rc==0 else {}
        except json.JSONDecodeError: info={}
        rc,out=capture(['/usr/local/sbin/coffee-update','list'],10)
        text=out if rc==0 and out else 'No cached upgrades are currently listed. Use Check Now to refresh package indexes.'
        self.update_list.get_buffer().set_text(text)
        if live:
            self.update_status.set_text('Live session: update installation is disabled. Install CoffeeOS first.')
        else:
            count=info.get('upgrade_count',0); coffee=info.get('coffeeos_upgrade_count',0)
            reboot=' · reboot required' if info.get('reboot_required') else ''
            self.update_status.set_text(f"CoffeeOS {info.get('version','unknown')} · cached upgrades: {count} ({coffee} CoffeeOS){reboot}")
        feed=info.get('feed_url','')
        self.update_channel.set_active_id(info.get('feed_suite','stable'))
        self.update_feed.set_text('CoffeeOS feed: '+(feed if feed else 'not configured — Debian Stable updates still work'))

    def set_update_channel(self,*_):
        channel=self.update_channel.get_active_id() or 'stable'
        if not self.confirm('Change CoffeeOS update channel?',f'Switch the signed CoffeeOS feed to {channel}? Debian Stable base updates are unchanged.'): return
        self.action('Set update channel',['pkexec','/usr/local/sbin/coffee-update','set-channel',channel],lambda _rc:self.refresh_updates())

    def check_updates(self,*_):
        self.action('Check for updates',['pkexec','/usr/local/sbin/coffee-update','check'],lambda _rc:self.refresh_updates())

    def install_updates(self,*_):
        if self.confirm('Install system updates?', 'Apply available Debian Stable and configured CoffeeOS updates in place? A CoffeeKernel update may require a reboot afterward.'):
            self.action('Install updates',['pkexec','/usr/local/sbin/coffee-update','upgrade'],lambda _rc:self.refresh_updates())

    def cleanup_updates(self,*_):
        if self.confirm('Clean old packages?', 'Remove packages no longer required and clean the local APT cache?'):
            self.action('Clean packages',['pkexec','/usr/local/sbin/coffee-update','cleanup'],lambda _rc:self.refresh_updates())

    def configure_update_feed(self,*_):
        dlg=Gtk.Dialog(title='CoffeeOS Update Source',transient_for=self,modal=True)
        dlg.add_buttons('Cancel',Gtk.ResponseType.CANCEL,'Remove Feed',2,'Save',Gtk.ResponseType.OK)
        area=dlg.get_content_area(); area.set_spacing(8); area.set_border_width(12)
        area.pack_start(self.label('CoffeeOS repositories must be HTTPS (or file:// for local testing) and signed with an OpenPGP public key.', 'muted'),False,False,0)
        grid=Gtk.Grid(column_spacing=8,row_spacing=8)
        url=Gtk.Entry(); url.set_placeholder_text('https://updates.example.com/coffeeos')
        suite=Gtk.Entry(); suite.set_text('stable')
        key=Gtk.FileChooserButton(title='Select CoffeeOS repository public key',action=Gtk.FileChooserAction.OPEN)
        grid.attach(Gtk.Label(label='Feed URL',xalign=0),0,0,1,1); grid.attach(url,1,0,1,1)
        grid.attach(Gtk.Label(label='Channel',xalign=0),0,1,1,1); grid.attach(suite,1,1,1,1)
        grid.attach(Gtk.Label(label='Public key',xalign=0),0,2,1,1); grid.attach(key,1,2,1,1)
        area.pack_start(grid,False,False,0); dlg.show_all(); response=dlg.run()
        if response==Gtk.ResponseType.OK:
            feed=url.get_text().strip(); channel=suite.get_text().strip(); keyfile=key.get_filename()
            dlg.destroy()
            if not feed or not channel or not keyfile:
                self.set_status('Feed URL, channel and public signing key are required.'); return
            self.action('Configure CoffeeOS update source',['pkexec','/usr/local/sbin/coffee-update','set-feed',feed,channel,keyfile],lambda _rc:self.refresh_updates())
            return
        if response==2:
            dlg.destroy()
            if self.confirm('Remove CoffeeOS update source?', 'Debian Stable updates will continue, but CoffeeOS-specific releases will stop until a feed is configured.'):
                self.action('Remove CoffeeOS update source',['pkexec','/usr/local/sbin/coffee-update','clear-feed'],lambda _rc:self.refresh_updates())
            return
        dlg.destroy()


def main():
    parser=argparse.ArgumentParser(description='CoffeeOS system settings')
    parser.add_argument('--page', choices=('overview','display','bluetooth','audio','power','input','security','apps','system','performance','gaming','appearance','software','updates'))
    args=parser.parse_args()
    apply_theme_style()
    win=CoffeeControlCenter()
    if args.page: win.stack.set_visible_child_name(args.page)
    win.connect('destroy',Gtk.main_quit); win.show_all(); Gtk.main()

if __name__=='__main__': main()
