    def refresh_input_region(self):
        rc,raw=capture(['coffee-desktop-settings','input-show'],4)
        try: data=json.loads(raw) if rc==0 else {}
        except ValueError: data={}
        self.input_pointer.set_value(float(data.get('pointer_speed',0.0))); self.input_natural.set_active(bool(data.get('natural_scroll',False))); self.input_tap.set_active(bool(data.get('tap',True))); self.input_rate.set_value(int(data.get('repeat_rate',25))); self.input_delay.set_value(int(data.get('repeat_delay',600))); self.input_layout.set_text(data.get('layout','us'))
        rc,out=capture(['coffee-admin-settings','time-status'],4); values={}
        if rc==0:
            for line in out.splitlines():
                if '=' in line: k,v=line.split('=',1); values[k]=v
        self.time_status.set_text(f"Timezone: {values.get('Timezone','unknown')} · NTP: {values.get('NTP','unknown')} · synchronized: {values.get('NTPSynchronized','unknown')}")
        self.timezone.set_text(values.get('Timezone',''))
        self.ntp.set_active(values.get('NTP','no')=='yes')
        self.locale_entry.set_text(os.environ.get('LANG',''))
    def apply_input(self,*_):
