    def refresh_security(self):
        rc,raw=capture(['coffee-desktop-settings','account'],4)
        try: account=json.loads(raw) if rc==0 else {}
        except ValueError: account={}
        self.account_user=account.get('username',''); self.account_name.set_text(account.get('display_name','')); self.account_status.set_text(f"User: {self.account_user or 'unknown'} · Avatar: {account.get('avatar') or 'default'}")
        rc,out=capture(['coffee-admin-settings','autologin-status'],4); enabled=False; user=''
        if rc==0:
            fields=out.split('\t',1); enabled=fields[0]=='enabled'; user=fields[1] if len(fields)>1 else ''
        self.account_updating=True; self.account_autologin.set_active(enabled and user==self.account_user); self.account_updating=False
        rc,out=capture(['coffee-admin-settings','firewall-status'],4); self.firewall_status.set_text('CoffeeOS firewall: '+(out or 'unknown'))
        rc,raw=capture(['coffee-desktop-settings','notifications-show'],4)
        try: n=json.loads(raw) if rc==0 else {}
        except ValueError: n={}
        self.notify_dnd.set_active(bool(n.get('dnd',False))); self.notify_timeout.set_value(int(n.get('timeout_ms',6000)))
    def apply_account(self,*_):
        user=getattr(self,'account_user','')
        if not user: return
        name=self.account_name.get_text().strip()
        desired='on' if self.account_autologin.get_active() else 'off'
        self.action('Save account settings',['pkexec','/usr/local/sbin/coffee-admin-settings','account-name',user,name],lambda rc:self.apply_autologin_after_name(rc,user,desired))
    def apply_autologin_after_name(self,rc,user,state):
        if rc==0: self.action('Save automatic login',['pkexec','/usr/local/sbin/coffee-admin-settings','autologin',state,user],lambda _rc:self.refresh_security())
    def choose_avatar(self,*_):
        d=Gtk.FileChooserDialog(title='Choose account avatar',parent=self,action=Gtk.FileChooserAction.OPEN); d.add_buttons(Gtk.STOCK_CANCEL,Gtk.ResponseType.CANCEL,Gtk.STOCK_OPEN,Gtk.ResponseType.OK); flt=Gtk.FileFilter(); flt.set_name('Images'); flt.add_pixbuf_formats(); d.add_filter(flt)
        if d.run()==Gtk.ResponseType.OK:
            rc,out=capture(['coffee-desktop-settings','avatar',d.get_filename()],5); self.set_status(out if rc==0 else 'Avatar change failed: '+out); self.refresh_security()
        d.destroy()
    def enable_firewall(self,*_):
        if self.confirm('Enable CoffeeOS firewall?','Block unsolicited inbound traffic while keeping outbound traffic, loopback, established connections, ICMP and DHCP working.'):
            self.action('Enable firewall',['pkexec','/usr/local/sbin/coffee-admin-settings','firewall-enable'],lambda _rc:self.refresh_security())
    def disable_firewall(self,*_):
        if self.confirm('Disable CoffeeOS firewall rules?','Only the CoffeeOS nftables table will be removed; unrelated firewall rules are left untouched.'):
            self.action('Disable CoffeeOS firewall',['pkexec','/usr/local/sbin/coffee-admin-settings','firewall-disable'],lambda _rc:self.refresh_security())
    def apply_notifications(self,*_):
        self.action('Save notification settings',['coffee-desktop-settings','notifications-set','--dnd','on' if self.notify_dnd.get_active() else 'off','--timeout',str(self.notify_timeout.get_value_as_int())],lambda _rc:self.refresh_security())

