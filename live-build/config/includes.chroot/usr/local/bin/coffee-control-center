        self.section(box,'Startup applications')
        self.startup_list=Gtk.ListBox(); self.startup_list.set_selection_mode(Gtk.SelectionMode.NONE); box.pack_start(self.startup_list,False,False,0)
        box.pack_start(self.button('Refresh Startup Apps',lambda *_:self.refresh_apps()),False,False,0)
