#!/usr/bin/env python3
import subprocess,tarfile,tempfile
from datetime import datetime
from pathlib import Path
def cap(argv,timeout=15):
    try:
        p=subprocess.run(argv,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=timeout,check=False);return p.stdout
    except Exception as exc:return str(exc)
def main():
    out=Path.home()/'Downloads';out.mkdir(parents=True,exist_ok=True);dest=out/f"coffeeos-installer-report-{datetime.now().strftime('%Y%m%d-%H%M%S')}.tar.gz"
    with tempfile.TemporaryDirectory() as td:
        root=Path(td)/'coffeeos-installer-report';root.mkdir()
        commands={'preflight':['coffee-installer-preflight','--json'],'lsblk':['lsblk','-f'],'boot':['cat','/proc/cmdline'],'network':['nmcli','-f','DEVICE,TYPE,STATE','device'],'journal':['journalctl','-b','-p','warning','--no-pager','-n','250']}
        for name,cmd in commands.items():(root/(name+'.txt')).write_text(cap(cmd),errors='replace')
        for src in (Path.home()/'.cache/calamares/session.log',Path('/var/log/Calamares.log'),Path('/tmp/calamares.log')):
            if src.is_file():
                try:(root/src.name).write_bytes(src.read_bytes()[:4_000_000])
                except OSError:pass
        with tarfile.open(dest,'w:gz') as tar:tar.add(root,arcname=root.name)
    print(dest)
if __name__=='__main__':main()
