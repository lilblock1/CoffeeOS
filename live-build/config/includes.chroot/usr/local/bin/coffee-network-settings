#!/usr/bin/env python3
import argparse,ipaddress,json,re,subprocess
def cap(argv,t=20):
    try:
        p=subprocess.run(argv,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=t,check=False);return p.returncode,p.stdout.strip()
    except Exception as exc:return 127,str(exc)
def wifi():
    _,out=cap(['nmcli','-t','-f','DEVICE,TYPE','device']);return next((x.split(':')[0] for x in out.splitlines() if x.endswith(':wifi')),'')
def status():
    _,active=cap(['nmcli','-t','-f','NAME,UUID,TYPE,DEVICE,METERED','connection','show','--active']);_,allc=cap(['nmcli','-t','-f','NAME,UUID,TYPE','connection','show']);_,conn=cap(['nmcli','networking','connectivity','check']);print(json.dumps({'connectivity':conn,'active':active.splitlines(),'connections':allc.splitlines(),'wifi_device':wifi()},indent=2))
def hotspot(on,ssid,password):
    dev=wifi()
    if not dev:raise SystemExit('No Wi-Fi adapter found.')
    if on:
        if not (1<=len(ssid)<=32) or len(password)<8:raise SystemExit('SSID must be 1-32 chars and password at least 8 chars.')
        rc,out=cap(['nmcli','device','wifi','hotspot','ifname',dev,'con-name','CoffeeOS-Hotspot','ssid',ssid,'password',password],30)
    else:rc,out=cap(['nmcli','connection','down','CoffeeOS-Hotspot'])
    print(out);raise SystemExit(rc)
def modify(uuid,key,value):
    if not re.fullmatch(r'[0-9A-Fa-f-]{36}',uuid):raise SystemExit('Invalid UUID.')
    if key=='dns':
        vals=[x.strip() for x in value.split(',') if x.strip()]
        for x in vals:ipaddress.ip_address(x)
        argv=['nmcli','connection','modify','uuid',uuid,'ipv4.ignore-auto-dns','yes' if vals else 'no','ipv4.dns',','.join(vals)]
    elif key=='metered':
        if value not in ('yes','no','unknown'):raise SystemExit('Invalid metered state.')
        argv=['nmcli','connection','modify','uuid',uuid,'connection.metered',value]
    else:
        n=int(value)
        if not -999<=n<=999:raise SystemExit('Priority out of range.')
        argv=['nmcli','connection','modify','uuid',uuid,'connection.autoconnect-priority',str(n)]
    rc,out=cap(argv);print(out);raise SystemExit(rc)
def main():
    ap=argparse.ArgumentParser();sp=ap.add_subparsers(dest='cmd',required=True);sp.add_parser('status');p=sp.add_parser('hotspot-on');p.add_argument('ssid');p.add_argument('password');sp.add_parser('hotspot-off')
    for c in ('dns','metered','priority'):p=sp.add_parser('set-'+c);p.add_argument('uuid');p.add_argument('value')
    a=ap.parse_args()
    if a.cmd=='status':status()
    elif a.cmd=='hotspot-on':hotspot(True,a.ssid,a.password)
    elif a.cmd=='hotspot-off':hotspot(False,'','')
    else:modify(a.uuid,a.cmd.removeprefix('set-'),a.value)
if __name__=='__main__':main()
