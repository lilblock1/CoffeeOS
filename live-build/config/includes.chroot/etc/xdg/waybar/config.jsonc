{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 2,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": [
    "custom/coffee",
    "wlr/taskbar"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "battery",
    "tray",
    "custom/updates",
    "custom/gaming",
    "custom/controlcenter",
    "custom/power"
  ],
  "custom/coffee": {
    "format": "☕  CoffeeOS",
    "tooltip": "Open applications",
    "on-click": "fuzzel"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "clock": {
    "format": "{:%a  •  %b %d  %H:%M}",
    "tooltip-format": "{:%A, %B %d, %Y}"
  },
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 10,
    "tooltip": true
  },
  "memory": {
    "format": "RAM {percentage}%",
    "interval": 10
  },
  "network": {
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "Ethernet",
    "format-disconnected": "Offline",
    "tooltip": true,
    "on-click": "coffee-wifi-menu",
    "on-click-right": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL Muted",
    "on-click": "coffee-control-center --page audio",
    "on-click-right": "pavucontrol",
    "scroll-step": 5
  },
  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "BAT {capacity}% +",
    "format-full": "BAT {capacity}%",
    "format-not-present": "",
    "interval": 30,
    "on-click": "coffee-control-center --page power"
  },
  "tray": {
    "spacing": 8
  },
  "custom/gaming": {
    "exec": "coffee-gaming-indicator",
    "return-type": "json",
    "interval": 2,
    "tooltip": true,
    "on-click": "coffee-control-center --page gaming"
  },
  "custom/controlcenter": {
    "format": "⚙",
    "tooltip": "Coffee Control Center",
    "on-click": "coffee-control-center"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": "Power menu",
    "on-click": "coffee-power-menu"
  },
  "custom/updates": {
    "exec": "coffee-update-indicator",
    "return-type": "json",
    "interval": 60,
    "tooltip": true,
    "on-click": "coffee-control-center"
  }
}
