<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <core><gap>4</gap></core>
  <theme>
    <name>CoffeeOS-Espresso-Noir</name>
    <icon>Adwaita</icon>
    <cornerRadius>12</cornerRadius>
    <dropShadows>yes</dropShadows>
    <titlebar><layout>icon:iconify,max,close</layout></titlebar>
    <font name="Cantarell" size="10" weight="medium" />
  </theme>
  <keyboard>
    <default />
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="W-space"><action name="Execute" command="fuzzel" /></keybind>
    <keybind key="W-d"><action name="Execute" command="fuzzel" /></keybind>
    <keybind key="W-e"><action name="Execute" command="thunar" /></keybind>
    <keybind key="W-s"><action name="Execute" command="coffee-quick-settings" /></keybind>
    <keybind key="W-c"><action name="Execute" command="coffee-control-center" /></keybind>
    <keybind key="W-p"><action name="Execute" command="coffee-power-menu" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="Print"><action name="Execute" command="coffee-screenshot" /></keybind>
    <keybind key="W-S-e"><action name="Exit" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="brightnessctl set +5%" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="brightnessctl set 5%-" /></keybind>
  </keyboard>
  <desktops><number>4</number></desktops>
</labwc_config>
