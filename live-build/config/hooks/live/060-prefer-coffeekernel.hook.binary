#!/bin/sh
set -eu
# Debian 13 live-build copies every kernel/initrd from chroot/boot into
# binary/live, and chooses the first LB_LINUX_FLAVOURS item for its default
# boot entries. CoffeeOS configures CoffeeKernel first. This hook verifies that
# contract before checksums/ISO creation instead of rewriting generated menus.

set -- config/packages.chroot/linux-image-*-coffee_*.deb
if [ ! -e "$1" ]; then
    echo 'CoffeeOS: no staged CoffeeKernel package (stock mode).'
    exit 0
fi
[ "$#" -eq 1 ] || {
    echo "CoffeeOS: expected one staged CoffeeKernel package, got $#" >&2
    exit 1
}

pkg=$(dpkg-deb -f "$1" Package)
version=${pkg#linux-image-}
case "$version" in
    *-coffee) ;;
    *) echo "CoffeeOS: invalid staged CoffeeKernel package: $pkg" >&2; exit 1 ;;
esac

kernel="binary/live/vmlinuz-$version"
initrd="binary/live/initrd.img-$version"
[ -s "$kernel" ] || {
    echo "CoffeeOS: live-build did not copy CoffeeKernel into /live: $kernel" >&2
    exit 1
}
[ -s "$initrd" ] || {
    echo "CoffeeOS: live-build did not copy CoffeeKernel initrd into /live: $initrd" >&2
    exit 1
}

# The source isolinux.cfg keeps live-amd64 for stock builds. Once a staged
# CoffeeKernel changes live-build's flavour to "coffee", the generated Syslinux
# label becomes live-coffee. Rewrite only the generated binary config so BIOS
# autoboot follows the actual custom-kernel label while stock builds remain
# untouched.
bios_cfg="binary/isolinux/isolinux.cfg"
bios_live_cfg="binary/isolinux/live.cfg"
if [ -f "$bios_cfg" ] && [ -f "$bios_live_cfg" ]; then
    coffee_label="live-coffee"
    grep -Eq "^label[[:space:]]+$coffee_label$" "$bios_live_cfg" || {
        echo "CoffeeOS: expected BIOS CoffeeKernel label is missing: $coffee_label" >&2
        exit 1
    }
    sed -i -E "s/^default[[:space:]]+.*/default $coffee_label/; s/^ontimeout[[:space:]]+.*/ontimeout $coffee_label/" "$bios_cfg"
    grep -Eq "^default[[:space:]]+$coffee_label$" "$bios_cfg" || {
        echo "CoffeeOS: failed to set BIOS default label to $coffee_label" >&2
        exit 1
    }
    grep -Eq "^ontimeout[[:space:]]+$coffee_label$" "$bios_cfg" || {
        echo "CoffeeOS: failed to set BIOS timeout label to $coffee_label" >&2
        exit 1
    }
    echo "CoffeeOS: BIOS Syslinux default now selects $coffee_label"
fi

found=0
for cfg in binary/boot/grub/grub.cfg binary/isolinux/live.cfg; do
    [ -f "$cfg" ] || continue
    if grep -Fq "/live/vmlinuz-$version" "$cfg" || grep -Fq "live/vmlinuz-$version" "$cfg"; then
        found=1
    fi
done

[ "$found" -eq 1 ] || {
    echo "CoffeeOS: CoffeeKernel exists but generated boot menus do not select vmlinuz-$version" >&2
    exit 1
}

echo "CoffeeOS: live-build selected CoffeeKernel as live boot default: $version"
