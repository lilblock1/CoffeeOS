#!/bin/sh
set -eu
# Debian 13 live-build copies every kernel/initrd from chroot/boot into
# binary/live, and chooses the first LB_LINUX_FLAVOURS item for its default
# boot entries. CoffeeOS configures CoffeeKernel first. This hook verifies that
# contract before checksums/ISO creation instead of rewriting generated menus.

set -- config/packages.chroot/linux-image-*-coffee_*.deb
if [ ! -e "$1" ]; then
    echo 'CoffeeOS: no staged CoffeeKernel package (stock mode).'
    exit 0
fi
[ "$#" -eq 1 ] || {
    echo "CoffeeOS: expected one staged CoffeeKernel package, got $#" >&2
    exit 1
}

pkg=$(dpkg-deb -f "$1" Package)
version=${pkg#linux-image-}
case "$version" in
    *-coffee) ;;
    *) echo "CoffeeOS: invalid staged CoffeeKernel package: $pkg" >&2; exit 1 ;;
esac

kernel="binary/live/vmlinuz-$version"
initrd="binary/live/initrd.img-$version"
[ -s "$kernel" ] || {
    echo "CoffeeOS: live-build did not copy CoffeeKernel into /live: $kernel" >&2
    exit 1
}
[ -s "$initrd" ] || {
    echo "CoffeeOS: live-build did not copy CoffeeKernel initrd into /live: $initrd" >&2
    exit 1
}

found=0
for cfg in binary/boot/grub/grub.cfg binary/isolinux/live.cfg; do
    [ -f "$cfg" ] || continue
    if grep -Fq "/live/vmlinuz-$version" "$cfg" || grep -Fq "live/vmlinuz-$version" "$cfg"; then
        found=1
    fi
done

[ "$found" -eq 1 ] || {
    echo "CoffeeOS: CoffeeKernel exists but generated boot menus do not select vmlinuz-$version" >&2
    exit 1
}

echo "CoffeeOS: live-build selected CoffeeKernel as live boot default: $version"
