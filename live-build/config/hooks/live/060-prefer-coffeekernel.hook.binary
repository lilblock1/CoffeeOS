#!/bin/sh
set -eu
# CoffeeKernel is installed inside the live chroot. live-build may create only
# the configured Debian flavour in binary/live before binary hooks run, so
# explicitly stage the custom kernel/initrd here and then point both bootloaders
# at it. The Debian kernel remains on the medium as the recovery fallback.

set -- chroot/boot/vmlinuz-*-coffee
if [ ! -e "$1" ]; then
    echo 'CoffeeOS: no CoffeeKernel in chroot/boot (stock mode); leaving Debian default.'
    exit 0
fi
[ "$#" -eq 1 ] || { echo "CoffeeOS: expected exactly one CoffeeKernel in chroot/boot, got $#" >&2; exit 1; }

source_kernel=$1
kernel=$(basename "$source_kernel")
version=${kernel#vmlinuz-}
source_initrd="chroot/boot/initrd.img-$version"
initrd="initrd.img-$version"
[ -s "$source_initrd" ] || { echo "CoffeeOS: missing CoffeeKernel initrd in chroot: $source_initrd" >&2; exit 1; }

mkdir -p binary/live
cp -f -- "$source_kernel" "binary/live/$kernel"
cp -f -- "$source_initrd" "binary/live/$initrd"
test -s "binary/live/$kernel"
test -s "binary/live/$initrd"

# Our GRUB file contains the CoffeeOS live entries. Rewrite kernel and initrd
# references to the explicitly staged custom pair.
if [ -f binary/boot/grub/grub.cfg ]; then
    sed -E -i \
      -e "s#([[:space:]]*linux[[:space:]]+)/live/vmlinuz[^[:space:]]*#\\1/live/$kernel#" \
      -e "s#([[:space:]]*initrd[[:space:]]+)/live/initrd[^[:space:]]*#\\1/live/$initrd#" \
      binary/boot/grub/grub.cfg
fi

# Patch normal/safe Syslinux entries as well. Debian's fallback kernel files are
# deliberately retained on the medium.
for cfg in binary/isolinux/live.cfg binary/isolinux/*.cfg; do
    [ -f "$cfg" ] || continue
    sed -E -i \
      -e "s#([[:space:]]*linux[[:space:]]+)/?live/vmlinuz[^[:space:]]*#\\1/live/$kernel#" \
      -e "s#([[:space:]]*initrd[[:space:]]+)/?live/initrd[^[:space:]]*#\\1/live/$initrd#" \
      "$cfg"
done

# Fail here, while the build tree is still available, rather than producing an
# ISO whose custom kernel exists but is not selected by any boot menu.
found=0
for cfg in binary/boot/grub/grub.cfg binary/isolinux/live.cfg; do
    [ -f "$cfg" ] || continue
    if grep -Fq "/live/$kernel" "$cfg"; then found=1; fi
done
[ "$found" -eq 1 ] || {
    echo "CoffeeOS: CoffeeKernel was staged but no boot menu references /live/$kernel" >&2
    exit 1
}

echo "CoffeeOS: CoffeeKernel staged and selected as live boot default: $kernel"
