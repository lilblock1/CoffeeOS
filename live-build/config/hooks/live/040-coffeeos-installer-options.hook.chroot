#!/bin/sh
set -eu

# Keep i386 metadata ready for optional Steam/Wine choices. No optional gaming
# packages are installed into the live image by this hook.
if ! dpkg --print-foreign-architectures | grep -qx i386; then
    dpkg --add-architecture i386
fi

SETTINGS=/etc/calamares/settings.conf
[ -f "$SETTINGS" ] || { echo "CoffeeOS: Calamares settings.conf missing" >&2; exit 1; }
[ -f /etc/calamares/modules/packagechooser-coffeeapps.conf ] || { echo "CoffeeOS: optional-software chooser missing" >&2; exit 1; }
[ -f /usr/lib/calamares/modules/coffeeapps/module.desc ] || { echo "CoffeeOS: optional-software job module missing" >&2; exit 1; }
[ -f /etc/calamares/branding/coffeeos/branding.desc ] || { echo "CoffeeOS: custom Calamares branding missing" >&2; exit 1; }

python3 - "$SETTINGS" <<'PY'
from pathlib import Path
import sys

p = Path(sys.argv[1])
text = p.read_text(encoding='utf-8')
lines = text.splitlines()

# Use CoffeeOS branding while retaining Debian's maintained installer modules.
branding_found = False
for i, line in enumerate(lines):
    if line.strip().startswith('branding:'):
        indent = line[:-len(line.lstrip())]
        lines[i] = indent + 'branding: coffeeos'
        branding_found = True
        break
if not branding_found:
    lines.append('branding: coffeeos')

# Ask for one final confirmation before Calamares begins destructive work.
for i, line in enumerate(lines):
    if line.strip().startswith('prompt-install:'):
        indent = line[:-len(line.lstrip())]
        lines[i] = indent + 'prompt-install: true'
        break

text = '\n'.join(lines) + '\n'
p.write_text(text, encoding='utf-8')

if 'packagechooser@coffeeapps' in text and any(line.strip() == '- coffeeapps' for line in lines):
    raise SystemExit(0)
try:
    seq = next(i for i, line in enumerate(lines) if line.strip() == 'sequence:')
except StopIteration:
    raise SystemExit('CoffeeOS: Calamares settings has no sequence section')

# Add only the packagechooser instance. The installer job is a dedicated
# CoffeeOS Python module so it can run *after* Debian's sources-final step.
# This avoids Debian's ordinary packages job trying to fetch optional software
# from the read-only live-media repository earlier in the install.
has_instances = any(line.strip() == 'instances:' for line in lines[:seq])
instance_lines = [
    '- id: coffeeapps',
    '  module: packagechooser',
    '  config: packagechooser-coffeeapps.conf',
]
if not any('packagechooser@coffeeapps' in line for line in lines[:seq]):
    if has_instances:
        lines[seq:seq] = instance_lines
        seq += len(instance_lines)
    else:
        block = ['instances:'] + instance_lines + ['']
        lines[seq:seq] = block
        seq += len(block)

# Add the optional-software UI before Summary.
if not any(line.strip() == '- packagechooser@coffeeapps' for line in lines):
    for i in range(seq, len(lines)):
        if lines[i].strip() == '- summary':
            indent = lines[i][:-len(lines[i].lstrip())]
            lines.insert(i, indent + '- packagechooser@coffeeapps')
            break
    else:
        raise SystemExit('CoffeeOS: could not locate Calamares summary page')

# Install the selected packages after sources-final has replaced the temporary
# live-media APT source with the normal Debian/CoffeeOS network repositories.
if not any(line.strip() == '- coffeeapps' for line in lines):
    for i, line in enumerate(lines):
        if line.strip() == '- sources-final':
            indent = line[:-len(line.lstrip())]
            lines.insert(i + 1, indent + '- coffeeapps')
            break
    else:
        raise SystemExit('CoffeeOS: could not locate Calamares sources-final job')

p.write_text('\n'.join(lines) + '\n', encoding='utf-8')
PY

# Debian's Calamares users module may enable libpwquality dictionary checks.
# Some live images do not ship a usable dictionary database, which makes every
# password fail with "error loading dictionary". CoffeeOS uses Calamares'
# built-in length validation instead, avoiding that broken external dependency.
python3 <<'PY'
from pathlib import Path

candidates = [
    Path("/etc/calamares/modules/users.conf"),
    Path("/usr/share/calamares/modules/users.conf"),
]

for p in candidates:
    if not p.is_file():
        continue

    lines = p.read_text(encoding="utf-8").splitlines()

    # Remove only the libpwquality subsection and its indented values.
    out = []
    i = 0
    while i < len(lines):
        line = lines[i]
        stripped = line.lstrip()
        if stripped.startswith("libpwquality:"):
            base_indent = len(line) - len(stripped)
            i += 1
            while i < len(lines):
                nxt = lines[i]
                nxt_stripped = nxt.lstrip()
                if not nxt_stripped or nxt_stripped.startswith("#"):
                    i += 1
                    continue
                indent = len(nxt) - len(nxt_stripped)
                if indent <= base_indent:
                    break
                i += 1
            continue
        out.append(line)
        i += 1

    # Keep a simple, deterministic CoffeeOS requirement: a non-trivial
    # password, without dictionary/CrackLib availability affecting the UI.
    found_requirements = False
    found_min = False
    for idx, line in enumerate(out):
        if line.strip() == "passwordRequirements:":
            found_requirements = True
            parent_indent = len(line) - len(line.lstrip())
            j = idx + 1
            while j < len(out):
                s = out[j].lstrip()
                if s and not s.startswith("#"):
                    indent = len(out[j]) - len(s)
                    if indent <= parent_indent:
                        break
                    if s.startswith("minLength:"):
                        out[j] = " " * indent + "minLength: 4"
                        found_min = True
                        break
                j += 1
            if not found_min:
                out.insert(idx + 1, " " * (parent_indent + 2) + "minLength: 4")
                found_min = True
            break

    if not found_requirements:
        out.extend(["", "passwordRequirements:", "  minLength: 4"])

    p.write_text("\n".join(out) + "\n", encoding="utf-8")
    print(f"CoffeeOS: disabled broken libpwquality dictionary validation in {p}")
PY

# Keep only the CoffeeOS-branded desktop launcher in the live menu.
rm -f /usr/share/applications/install-debian.desktop /usr/share/applications/calamares.desktop

echo 'CoffeeOS: custom Calamares branding and optional-software page enabled.'
